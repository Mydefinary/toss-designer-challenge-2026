# ── MEETSYNC 독립 백엔드 환경변수 예시 ──────────────────────────────
# 이 파일을 server/.env 로 복사한 뒤 값을 채운다. server/.env 는 git 무시됨.

# uvicorn 포트 (정치불신 8000 과 분리된 MEETSYNC 전용)
PORT=8010

# ── Anthropic (자연어 제약 파서 프록시) ──
# 키를 비워두면 /parse-constraints 는 503 을 반환하고 프론트가 로컬 파서로 폴백한다.
# ⚠ 키는 서버 env 에만 두고 절대 프론트/소스에 하드코딩하지 않는다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_TIMEOUT_S=10

# ── Database (MariaDB, 별도 database `meetsync`) ──
# 정치불신 MariaDB 컨테이너(127.0.0.1:3306)를 재사용하되 DB 는 `meetsync` 로 분리.
# 자격증명은 여기서만 주입한다(하드코딩 금지). 형식:
#   mysql+pymysql://<user>:<password>@127.0.0.1:3306/meetsync?charset=utf8mb4
# (정치불신과 동일 DB 계정을 써도 되지만 database 이름은 반드시 meetsync)
DATABASE_URL=mysql+pymysql://<user>:<password>@127.0.0.1:3306/meetsync?charset=utf8mb4

# ── CORS ──
# 배포 프론트 오리진. 비워두면 로컬 dev 오리진(localhost:5173/5175)만 허용.
# 경로/same-origin nginx 프록시 배포에서는 비워둬도 무해.
MEETSYNC_ORIGIN=
